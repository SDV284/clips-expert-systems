;;; Завдання 1: Дослідження функцій користувача (deffunction) у CLIPS
;;; Студент: Святішенко, група ІН-32-2
;;; =========================================================

;;; ---------------------------------------------------------
;;; 1. Функція з обов'язковими та груповими (wildcard) параметрами
;;; ---------------------------------------------------------
(deffunction print-args (?A ?B $?C)
   "Демонструє передачу двох обов'язкових та довільної кількості додаткових параметрів"
   (printout t "Обов'язкові параметри: A = " ?A ", B = " ?B crlf)
   (printout t "Додаткових параметрів: " (length$ ?C) ", список: " ?C crlf))

;;; ---------------------------------------------------------
;;; 2. Саморекурсивна функція обчислення факторіалу
;;; ---------------------------------------------------------
(deffunction factorial (?A)
   "Рекурсивне обчислення факторіалу з валідацією типу та знаку аргументу"
   (if (or (not (integerp ?A)) (< ?A 0))
      then (printout t "[Помилка] Аргумент повинен бути невід'ємним цілим числом!" crlf)
           FALSE
      else (if (= ?A 0)
              then 1
              else (* ?A (factorial (- ?A 1))))))

;;; ---------------------------------------------------------
;;; 3. Взаємна рекурсія та механізм попереднього оголошення
;;; ---------------------------------------------------------

;; Попереднє оголошення функції is-even (Forward Declaration)
(deffunction is-even (?N))

;; Оголошення функції is-odd, що викликає ще не реалізовану is-even
(deffunction is-odd (?N)
   "Перевіряє непарність числа через взаємний виклик is-even"
   (if (= ?N 0)
      then FALSE
      else (if (< ?N 0)
              then (is-odd (- 0 ?N))
              else (is-even (- ?N 1)))))

;; Повна реалізація функції is-even
(deffunction is-even (?N)
   "Перевіряє парність числа через взаємний виклик is-odd"
   (if (= ?N 0)
      then TRUE
      else (if (< ?N 0)
              then (is-even (- 0 ?N))
              else (is-odd (- ?N 1)))))

;;; ---------------------------------------------------------
;;; 4. Обчислювальна геометрична функція (евклідова відстань)
;;; ---------------------------------------------------------
(deffunction euclidean-distance (?x1 ?y1 ?x2 ?y2)
   "Обчислює евклідову відстань між двома точками на площині"
   (bind ?dx (- ?x2 ?x1))
   (bind ?dy (- ?y2 ?y1))
   (sqrt (+ (* ?dx ?dx) (* ?dy ?dy))))

;;; ---------------------------------------------------------
;;; Шаблони та факти для тестування виклику функцій з правил
;;; ---------------------------------------------------------
(deftemplate number-item
   (slot id (type SYMBOL))
   (slot value (type INTEGER))
)

(deffacts initial-numbers
   (number-item (id item-1) (value 5))
   (number-item (id item-2) (value 6))
   (number-item (id item-3) (value 7))
)

;;; ---------------------------------------------------------
;;; Продукційні правила, що інтегрують виклики функцій
;;; ---------------------------------------------------------

;; Виклик користувацьких функцій з RHS (actions)
(defrule rule-compute-factorials
   (declare (salience 20))
   (number-item (id ?id) (value ?v))
=>
   (bind ?f (factorial ?v))
   (bind ?parity (if (is-even ?v) then "парне" else "непарне"))
   (printout t "[RHS Виклик] " ?id ": значення = " ?v " (" ?parity "), факторіал " ?v "! = " ?f crlf)
)

;; Виклик користувацької функції з LHS (pattern / test element)
(defrule rule-filter-even-numbers
   (declare (salience 10))
   (number-item (id ?id) (value ?v))
   (test (is-even ?v))
=>
   (printout t "[LHS Фільтр: is-even] Знайдено парний елемент: " ?id " зі значенням " ?v crlf)
)
